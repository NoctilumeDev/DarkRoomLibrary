# Copy to .env only for local Compose use. Do not commit real credentials.
# Set to prod only for a real deployment; known defaults then fail fast.
DRL_SPRING_PROFILES_ACTIVE=
DRL_MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-password
DRL_RABBITMQ_USERNAME=drl
DRL_RABBITMQ_PASSWORD=replace-with-a-strong-local-password
DRL_JWT_SECRET=replace-with-at-least-32-random-bytes

# Host ports. Container-to-container ports stay unchanged.
DRL_MYSQL_PORT=3307
DRL_REDIS_PORT=6380
DRL_RABBITMQ_PORT=5673
DRL_RABBITMQ_MANAGEMENT_PORT=15673

# Public frontend origin and optional mail credentials.
DRL_CORS_ORIGINS=http://localhost:5175
DRL_TRUST_FORWARDED_HEADERS=false
DRL_TRUSTED_PROXY_CIDRS=
DRL_MAIL_USERNAME=
DRL_MAIL_PASSWORD=
DRL_NOTIFICATION_ALERT_WEBHOOK_URL=
DRL_NOTIFICATION_ALERT_WEBHOOK_TOKEN=

# Optional JVM tuning.
DRL_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
