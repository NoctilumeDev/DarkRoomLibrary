<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.darkroomlibrary.mapper.BookReviewReportMapper">

    <select id="findByIdForUpdate" resultType="org.darkroomlibrary.domain.model.BookReviewReport">
        SELECT *
        FROM book_review_report
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <sql id="queryWhere">
        <if test="status != null">
            AND brr.status = #{status}
        </if>
        <if test="bookName != null and bookName != ''">
            AND b.name LIKE concat('%', #{bookName}, '%')
        </if>
        <if test="reviewContent != null and reviewContent != ''">
            AND br.content LIKE concat('%', #{reviewContent}, '%')
        </if>
        <if test="startTime != null and endTime != null">
            AND brr.create_time BETWEEN #{startTime} AND #{endTime}
        </if>
    </sql>

    <select id="query" resultMap="BookReviewReportViewMap">
        SELECT
            brr.id,
            brr.review_id,
            brr.user_id AS report_user_id,
            report_user.user_name AS report_user_name,
            br.user_id AS review_user_id,
            review_user.user_name AS review_user_name,
            br.book_id,
            b.name AS book_name,
            br.rating,
            br.content AS review_content,
            br.status AS review_status,
            brr.reason,
            brr.status,
            brr.create_time,
            brr.handle_time
        FROM book_review_report brr
        LEFT JOIN book_review br ON brr.review_id = br.id
        LEFT JOIN book b ON br.book_id = b.id
        LEFT JOIN user report_user ON brr.user_id = report_user.id
        LEFT JOIN user review_user ON br.user_id = review_user.id
        <where>
            <include refid="queryWhere"/>
        </where>
        ORDER BY brr.status ASC, brr.id DESC
        <if test="current != null and size != null">
            LIMIT #{size} OFFSET #{current}
        </if>
    </select>

    <select id="queryCount" resultType="integer">
        SELECT COUNT(*)
        FROM book_review_report brr
        LEFT JOIN book_review br ON brr.review_id = br.id
        LEFT JOIN book b ON br.book_id = b.id
        <where>
            <include refid="queryWhere"/>
        </where>
    </select>

    <select id="countByReviewId" resultType="integer">
        SELECT COUNT(*)
        FROM book_review_report
        WHERE review_id = #{reviewId}
    </select>

    <select id="countPendingByReviewId" resultType="integer">
        SELECT COUNT(*)
        FROM book_review_report
        WHERE review_id = #{reviewId}
          AND status = 0
    </select>

    <select id="countByReviewIdAndUserId" resultType="integer">
        SELECT COUNT(*)
        FROM book_review_report
        WHERE review_id = #{reviewId}
          AND user_id = #{userId}
    </select>

    <delete id="deleteByReviewIds">
        DELETE FROM book_review_report
        WHERE review_id IN
        <foreach collection="reviewIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <resultMap id="BookReviewReportViewMap" type="org.darkroomlibrary.web.view.BookReviewReportView">
        <id column="id" property="id"/>
        <result column="review_id" property="reviewId"/>
        <result column="report_user_id" property="reportUserId"/>
        <result column="report_user_name" property="reportUserName"/>
        <result column="review_user_id" property="reviewUserId"/>
        <result column="review_user_name" property="reviewUserName"/>
        <result column="book_id" property="bookId"/>
        <result column="book_name" property="bookName"/>
        <result column="rating" property="rating"/>
        <result column="review_content" property="reviewContent"/>
        <result column="review_status" property="reviewStatus"/>
        <result column="reason" property="reason"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="handle_time" property="handleTime"/>
    </resultMap>

</mapper>
