<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.darkroomlibrary.mapper.ProcurementLogisticsMapper">

    <select id="getByOrderId" resultMap="BaseResultMap">
        SELECT pl.*
        FROM procurement_logistics pl
        WHERE pl.order_id = #{orderId}
        LIMIT 1
    </select>

    <resultMap id="BaseResultMap" type="org.darkroomlibrary.domain.model.ProcurementLogistics">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="logistics_user_id" property="logisticsUserId"/>
        <result column="status" property="status"/>
        <result column="tracking_no" property="trackingNo"/>
        <result column="carrier" property="carrier"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
</mapper>
