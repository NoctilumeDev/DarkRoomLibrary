<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.darkroomlibrary.mapper.BookReviewMapper">

    <!-- ==================== 公共 SQL 片段 ==================== -->
    <sql id="queryWhere">
        <if test="userId != null">
            AND br.user_id = #{userId}
        </if>
        <if test="bookId != null">
            AND br.book_id = #{bookId}
        </if>
        AND br.status = 0
        AND br.is_deleted = 0
        <if test="startTime != null and endTime != null">
            AND br.create_time BETWEEN #{startTime} AND #{endTime}
        </if>
    </sql>

    <select id="findByIdForUpdate" resultMap="BaseResultMap">
        SELECT br.*
        FROM book_review br
        WHERE br.id = #{id}
        FOR UPDATE
    </select>

    <select id="findByIdsForUpdate" resultMap="BaseResultMap">
        SELECT br.*
        FROM book_review br
        WHERE br.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY br.id
        FOR UPDATE
    </select>

    <update id="moveToRecycleBin">
        UPDATE book_review
        SET is_deleted = 1,
            deleted_at = #{deletedAt},
            restore_deadline = #{restoreDeadline},
            expired_at = NULL
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
          AND user_id = #{userId}
          AND status = 0
          AND is_deleted = 0
    </update>

    <update id="hideByAdministrator">
        UPDATE book_review
        SET status = 1
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
          </foreach>
          AND status = 0
          AND is_deleted = 0
    </update>

    <update id="restoreFromRecycleBin">
        UPDATE book_review
        SET is_deleted = 0,
            deleted_at = NULL,
            restore_deadline = NULL,
            expired_at = NULL
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
          AND user_id = #{userId}
          AND status = 0
          AND is_deleted = 1
          AND expired_at IS NULL
          AND restore_deadline &gt; #{now}
    </update>

    <update id="markExpired">
        UPDATE book_review
        SET expired_at = #{now}
        WHERE is_deleted = 1
          AND expired_at IS NULL
          AND restore_deadline &lt;= #{now}
    </update>

    <!-- ==================== 查询操作 ==================== -->
    <!-- 分页查询（关联用户和图书） -->
    <select id="query" resultMap="BookReviewViewMap">
        SELECT br.*, u.user_name, b.name AS book_name
        FROM book_review br
        LEFT JOIN user u ON br.user_id = u.id
        LEFT JOIN book b ON br.book_id = b.id
        <where>
            <include refid="queryWhere"/>
        </where>
        <choose>
            <when test="sortBy == 'hot'">
                ORDER BY (
                    SELECT COUNT(*)
                    FROM book_review_like brl
                    WHERE brl.review_id = br.id
                ) DESC, br.id DESC
            </when>
            <otherwise>
                ORDER BY br.id DESC
            </otherwise>
        </choose>
        <if test="current != null and size != null">
            LIMIT #{size} OFFSET #{current}
        </if>
    </select>

    <!-- 计数：无关联表过滤时无需 JOIN -->
    <select id="queryCount" resultType="integer">
        SELECT COUNT(*)
        FROM book_review br
        <where>
            <include refid="queryWhere"/>
        </where>
    </select>

    <select id="queryRecycleBin" resultMap="BookReviewViewMap">
        SELECT br.*, u.user_name, b.name AS book_name
        FROM book_review br
        LEFT JOIN user u ON br.user_id = u.id
        LEFT JOIN book b ON br.book_id = b.id
        WHERE br.user_id = #{userId}
          AND br.status = 0
          AND br.is_deleted = 1
          AND br.expired_at IS NULL
          AND br.restore_deadline &gt; #{now}
        ORDER BY br.deleted_at DESC, br.id DESC
        LIMIT #{size} OFFSET #{current}
    </select>

    <select id="queryRecycleBinCount" resultType="integer">
        SELECT COUNT(*)
        FROM book_review br
        WHERE br.user_id = #{userId}
          AND br.status = 0
          AND br.is_deleted = 1
          AND br.expired_at IS NULL
          AND br.restore_deadline &gt; #{now}
    </select>

    <!-- ==================== 结果映射 ==================== -->
    <resultMap id="BaseResultMap" type="org.darkroomlibrary.domain.model.BookReview">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="book_id" property="bookId"/>
        <result column="rating" property="rating"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="restore_deadline" property="restoreDeadline"/>
        <result column="expired_at" property="expiredAt"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <resultMap id="BookReviewViewMap" type="org.darkroomlibrary.web.view.BookReviewView">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="book_id" property="bookId"/>
        <result column="rating" property="rating"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="restore_deadline" property="restoreDeadline"/>
        <result column="create_time" property="createTime"/>
        <result column="user_name" property="userName"/>
        <result column="book_name" property="bookName"/>
    </resultMap>

</mapper>
