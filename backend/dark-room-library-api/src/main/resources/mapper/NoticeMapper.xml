<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.darkroomlibrary.mapper.NoticeMapper">

    <!-- ==================== 公共 SQL 片段 ==================== -->
    <sql id="queryWhere">
        <if test="name != null and name != ''">
            AND n.name LIKE concat('%',#{name},'%')
        </if>
        <if test="startTime != null and endTime != null">
            AND n.create_time BETWEEN #{startTime} AND #{endTime}
        </if>
    </sql>

    <!-- ==================== 写入操作 ==================== -->
    <insert id="save">
        INSERT INTO notice (name, content, create_time)
        VALUES (#{name}, #{content}, #{createTime})
    </insert>

    <!-- ==================== 查询操作 ==================== -->
    <select id="query" resultMap="BaseResultMap">
        SELECT n.*
        FROM notice n
        <where>
            <include refid="queryWhere"/>
        </where>
        ORDER BY n.create_time DESC
        <if test="current != null and size != null">
            LIMIT #{size} OFFSET #{current}
        </if>
    </select>

    <select id="queryCount" resultType="integer">
        SELECT COUNT(*)
        FROM notice n
        <where>
            <include refid="queryWhere"/>
        </where>
    </select>

    <!-- ==================== 结果映射 ==================== -->
    <resultMap id="BaseResultMap" type="org.darkroomlibrary.domain.model.Notice">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

</mapper>
